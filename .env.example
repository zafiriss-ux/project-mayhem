# TITAN v51 Environment Variables

# Garmin Connect
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_secure_password
# Optional: encrypt the persisted Garth session token (recommended for production).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TITAN_GARTH_TOKEN_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_api_key_here
WEATHER_LOCATION=Athens,GR

# Athlete Profile
ATHLETE_NAME=YourName
ATHLETE_AGE=40
ATHLETE_WEIGHT=75.0
ATHLETE_HEIGHT=175
ATHLETE_MAX_HR=185
ATHLETE_THRESHOLD_HR=165
TRAINING_PHASE=BUILD
TRAINING_GOAL=10K

# Database
DATABASE_PATH=data/database/titan.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=data/logs
