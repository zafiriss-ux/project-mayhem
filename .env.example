# TITAN OS Environment Variables (see titan/config/settings.py)

# Garmin Connect
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_secure_password
# Optional: encrypt the persisted Garth session token (recommended for production).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TITAN_GARTH_TOKEN_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789
# Only if TELEGRAM_CHAT_ID is a group (starts with -): your own Telegram user id.
# In a group only your messages are commands; without it the bot answers nobody there.
TELEGRAM_OWNER_USER_ID=

# Weather
WEATHER_LOCATION=Athens,GR

# Athlete Profile
ATHLETE_NAME=YourName
ATHLETE_AGE=40
ATHLETE_WEIGHT=75.0
ATHLETE_HEIGHT=175
ATHLETE_MAX_HR=185
ATHLETE_THRESHOLD_HR=165
TRAINING_PHASE=BUILD
TRAINING_GOAL=10K

# Database
# Docker: DB lives at /data/titan_core.db
# Local: ~/Documents/TITAN/titan_core.db
# NEVER use titan.db — stale file
DATABASE_PATH=data/database/titan_core.db

# Logging
LOG_LEVEL=INFO

# Athletes other than the owner (ADR-0067; docs/runbooks/multi-athlete.md)
# Docker reads this file; locally `python -m titan.worker` and scripts/athletes.py do not,
# so export the same three variables in their shell instead.
# 1 = the morning round also runs every ready athlete, the owner first.
# TITAN_MULTI_ATHLETE=1
# Docker sets these two to /secrets (titan-secrets volume). Outside the data folder,
# and the deletion record outside the backups too.
# TITAN_TOKEN_KEY_FILE=~/.titan-secrets/athlete_token.key
# TITAN_DELETION_RECORD_FILE=~/.titan-secrets/deletions.jsonl
