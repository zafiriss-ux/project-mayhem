# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# TITAN runtime data
titan_core.db
titan_core.db-journal
titan_core.db-wal
titan_core.db-shm
*.db
athletes/

# Cursor
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Claude Code
#  Internal session data, worktrees, and tool results created by Claude Code CLI.
#  Ignore everything under .claude/ EXCEPT shared, version-controlled project
#  config: settings.json and the hooks/ directory (e.g. the SessionStart CI
#  bootstrap, ADR-0059 / CI_SURFACE_AUDIT_2026-06-06). settings.local.json and
#  session data remain ignored.
.claude/*
!.claude/settings.json
!.claude/hooks/
# Garmin session token (plaintext and encrypted)
.garth_token
.garth_token.enc
# Skipper — machine-local artifacts (hook scratch + derived index), never commit
.claude/.skipper-*
.skipper/*
!.skipper/receipts/

# simple-workflow plugin artifacts (local-only; delete entries to share via git)
.simple-workflow/
.simple-workflow
