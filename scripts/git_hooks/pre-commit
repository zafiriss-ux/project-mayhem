#!/usr/bin/env bash
# TITAN OS — Pre-commit gate runner
# Automatically enforces the three mandatory engineering gates before every commit.
# Install once via:  bash scripts/install_git_hooks.sh
#
# Gates (canonical: AGENTS.md §HARD GATE / CLAUDE.md):
#   Gate 1 — Ruff lint     (zero findings required)
#   Gate 2 — Strict pytest (warnings are failures)
#   Gate 3 — Full pytest   (100% green, count stable)

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo "══════════════════════════════════════════════════"
echo "  TITAN OS — Pre-commit Engineering Gates"
echo "══════════════════════════════════════════════════"

# ── Gate 1: Ruff lint ─────────────────────────────────────────────────────────
echo ""
echo -e "${YELLOW}[Gate 1]${NC} Ruff lint — zero findings required..."
if python -m ruff check .; then
    echo -e "${GREEN}✓ Gate 1 PASSED${NC}"
else
    echo -e "${RED}✗ Gate 1 FAILED — fix lint errors before committing${NC}"
    echo "  Run: python -m ruff check . --fix"
    exit 1
fi

# ── Gate 2: Strict pytest (warnings are failures) ─────────────────────────────
echo ""
echo -e "${YELLOW}[Gate 2]${NC} Strict pytest — warnings are failures..."
if python -m pytest -q -W error::pytest.PytestWarning 2>&1; then
    echo -e "${GREEN}✓ Gate 2 PASSED${NC}"
else
    echo -e "${RED}✗ Gate 2 FAILED — fix warnings/failures before committing${NC}"
    exit 1
fi

# ── Gate 3: Full canonical pytest ────────────────────────────────────────────
echo ""
echo -e "${YELLOW}[Gate 3]${NC} Canonical pytest — 100% green required..."
if python -m pytest -q 2>&1; then
    echo -e "${GREEN}✓ Gate 3 PASSED${NC}"
else
    echo -e "${RED}✗ Gate 3 FAILED — all tests must be green before committing${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}══════════════════════════════════════════════════"
echo -e "  All 3 gates PASSED — commit proceeding"
echo -e "══════════════════════════════════════════════════${NC}"
echo ""
